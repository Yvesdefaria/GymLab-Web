---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
---
<BaseLayout title={`${title} — GymLab`} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <p class="kicker">Legal</p>
    <h1 class="mt-3 text-3xl font-bold md:text-4xl">{title}</h1>
    {updated && <p class="mt-3 text-sm text-muted">Última actualización: {updated}</p>}
    <div class="legal-prose">
      <slot />
    </div>
    <p class="mt-10 text-xs text-muted/70">
      Documento informativo; no constituye asesoramiento legal.
    </p>
  </article>
</BaseLayout>
