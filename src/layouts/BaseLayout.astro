---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, localeSwitchPath, useTranslations } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

const { title = t.meta.home.title, description = t.meta.home.description } = Astro.props;

const siteURL = Astro.site ?? new URL('https://gymlab.dev');
// Canonical and alternates are built by the same function, so a page can never
// advertise two different forms of its own URL.
const canonicalURL = new URL(localeSwitchPath(Astro.url.pathname, lang), siteURL);
const ogImageURL = new URL('/og/gymlab-og.jpg', siteURL);

// Reciprocal alternates: the same path in both locales, with Spanish as x-default.
const alternateEsURL = new URL(localeSwitchPath(Astro.url.pathname, 'es'), siteURL);
const alternateEnURL = new URL(localeSwitchPath(Astro.url.pathname, 'en'), siteURL);
const ogLocale = lang === 'en' ? 'en_GB' : 'es_ES';

const isLanding = /^\/(?:es|en)\/?$/.test(Astro.url.pathname);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={alternateEsURL} />
    <link rel="alternate" hreflang="en" href={alternateEnURL} />
    <link rel="alternate" hreflang="x-default" href={alternateEsURL} />
    {isLanding && (
      <link rel="preload" as="image" href="/images/home-hero.webp" fetchpriority="high" />
    )}
    <meta name="theme-color" content="#121214" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GymLab" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/png" href="/brand/icon-192.png" />
    <link rel="apple-touch-icon" href="/brand/icon-192.png" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <div class="app-grain" aria-hidden="true"></div>
  </body>
</html>
