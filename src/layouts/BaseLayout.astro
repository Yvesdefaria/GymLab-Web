---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GymLab — App de entrenamiento y progreso',
  description = 'Planifica tu rutina, registra cada serie y mira tu progreso en gráficos. 873 ejercicios y 9 calculadoras. Próximamente en Google Play y App Store.',
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://gymlab.dev');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL('/og/gymlab-og.jpg', siteURL);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#121214" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GymLab" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GymLab — Deja de entrenar de memoria" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/png" href="/brand/icon-192.png" />
    <link rel="apple-touch-icon" href="/brand/icon-192.png" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <div class="app-grain" aria-hidden="true"></div>
  </body>
</html>
