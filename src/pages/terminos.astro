---
// Fallback for the legacy `/terminos`. `public/_redirects` sends this path to
// `/es/terminos/` with a real 301 in production; this stub covers `astro dev`,
// where `_redirects` is not applied.
const target = 'https://gymlab.dev/es/terminos/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Términos y Condiciones — GymLab</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content="0; url=/es/terminos/" />
    <script is:inline>
      location.replace('/es/terminos/');
    </script>
  </head>
  <body>
    <p><a href="/es/terminos/">GymLab</a></p>
  </body>
</html>
