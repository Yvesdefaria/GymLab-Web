---
// Fallback for the legacy `/privacidad`. `public/_redirects` sends this path to
// `/es/privacidad/` with a real 301 in production, but Cloudflare's `_redirects`
// is not applied by `astro dev`, so this static stub performs the same hop in
// the browser. Play Console and the app's Health Connect rationale link here.
const target = 'https://gymlab.dev/es/privacidad/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Política de Privacidad — GymLab</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content="0; url=/es/privacidad/" />
    <script is:inline>
      location.replace('/es/privacidad/');
    </script>
  </head>
  <body>
    <p><a href="/es/privacidad/">GymLab</a></p>
  </body>
</html>
