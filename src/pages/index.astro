---
// Fallback for `/`. `public/_redirects` handles this in production with a 302,
// but Cloudflare's `_redirects` is not applied by `astro dev`, so this static
// stub performs the same hop in the browser.
const target = 'https://gymlab.dev/es/';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>GymLab — App de entrenamiento y progreso</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content="0; url=/es/" />
    <script is:inline>
      location.replace('/es/');
    </script>
  </head>
  <body>
    <p><a href="/es/">GymLab</a></p>
  </body>
</html>
