---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    n: '01',
    title: 'Llega con la rutina lista',
    text: 'Elige objetivo y nivel, parte de una de las 68 plantillas y ajusta días, ejercicios y series a tu semana.',
  },
  {
    n: '02',
    title: 'Registra sin cortar el ritmo',
    text: 'Peso, repeticiones y descanso con temporizador integrado. La siguiente serie empieza con un solo toque.',
  },
  {
    n: '03',
    title: 'Mira qué sube y qué se estancó',
    text: 'Gráficos por ejercicio, grupo muscular y periodo. Ves el progreso y también los meses sin avance.',
  },
  {
    n: '04',
    title: '9 calculadoras donde entrenas',
    text: 'IMC, calorías y macros, 1RM, grasa corporal, agua y medidas. Los cálculos resueltos en la misma app.',
  },
  {
    n: '05',
    title: '873 ejercicios con foto',
    text: 'Catálogo completo con filtros por músculo, equipo y categoría. Encuentras el ejercicio antes de la primera serie.',
  },
  {
    n: '06',
    title: 'Tu espejo, con memoria',
    text: 'Guarda fotos de progreso y compara cómo cambió tu físico con el tiempo.',
  },
  {
    n: '07',
    title: 'Pasos y dispositivos, conectados',
    text: 'Pasos diarios, widgets para Android y sincronización con tus dispositivos. El movimiento fuera del gimnasio también suma.',
  },
  {
    n: '08',
    title: 'Logros que sostienen la constancia',
    text: 'Rachas, objetivos y logros. Un empujón para volver el día que no tienes ganas.',
  },
];

const faqs = [
  {
    q: '¿Funciona sin conexión?',
    a: 'Sí. Puedes entrenar, registrar series y consultar tu historial sin internet. Todo queda guardado en tu teléfono.',
  },
  {
    q: '¿Dónde se guardan mis datos?',
    a: 'En tu teléfono. GymLab no te pide una cuenta para entrenar y tu historial no se sube a servidores de terceros. El detalle está en la política de privacidad.',
  },
  {
    q: '¿Sirve si estoy empezando?',
    a: 'Sí. Eliges nivel y objetivo, y una plantilla te marca por dónde empezar. También puedes crear tu rutina desde cero.',
  },
  {
    q: '¿Qué incluye el catálogo de ejercicios?',
    a: '873 ejercicios con foto, filtrables por músculo, categoría y equipamiento.',
  },
  {
    q: '¿Cuándo y en qué tiendas sale?',
    a: 'Estamos preparando el lanzamiento para Google Play y App Store. Si quieres enterarte el día uno, escríbenos a gymlab@gymlab.dev.',
  },
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="hero-atmosphere" aria-hidden="true">
      <img src="/images/home-hero.jpg" alt="" />
    </div>
    <div class="relative z-10 mx-auto max-w-5xl px-6 pb-20 pt-16 md:pb-28 md:pt-24">
      <p class="kicker">App de entrenamiento</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-tight md:text-6xl">
        Deja de entrenar <span class="gold-text">de memoria</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">
        GymLab organiza tu rutina, registra cada serie mientras entrenas y te muestra tu
        progreso en gráficos. Funciona sin conexión, incluso donde no hay señal.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <span class="chip">Próximamente en Google Play</span>
        <span class="chip">Próximamente en App Store</span>
      </div>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="mailto:gymlab@gymlab.dev?subject=GymLab%3A%20av%C3%ADsame%20cuando%20salga"
          class="gold-gradient rounded-full px-6 py-3 font-semibold text-on-gold transition-transform hover:-translate-y-0.5"
        >
          Avísame cuando salga
        </a>
        <a
          href="#features"
          class="rounded-full border border-border px-6 py-3 font-medium text-fg transition-colors hover:border-accent hover:text-accent"
        >
          Ver funciones
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-20 md:py-24">
    <p class="kicker">Funciones</p>
    <h2 class="mt-3 text-3xl font-semibold md:text-4xl">De la rutina al gráfico</h2>
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        features.map((feature) => (
          <article class="panel p-6">
            <span class="stat-value text-2xl">{feature.n}</span>
            <h3 class="mt-3 text-xl">{feature.title}</h3>
            <p class="mt-2 text-sm text-muted">{feature.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Showcase -->
  <section id="capturas" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-20 md:py-24">
    <p class="kicker">Capturas</p>
    <h2 class="mt-3 text-3xl font-semibold md:text-4xl">Así se ve mientras entrenas</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        [
          { src: '/screens/entrenamiento.png', caption: 'Sesión en vivo, con temporizador' },
          { src: '/screens/rutinas.png', caption: '68 plantillas listas para empezar' },
          { src: '/screens/ejercicios.png', caption: 'Catálogo de 873 ejercicios' },
        ].map((shot) => (
          <figure class="panel-floating p-3">
            <img
              src={shot.src}
              alt={`GymLab — ${shot.caption}`}
              width="375"
              height="812"
              loading="lazy"
              class="w-full rounded-lg"
            />
            <figcaption class="px-2 pt-3 text-sm text-muted">{shot.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- Privacy strip -->
  <section class="mx-auto max-w-5xl px-6 py-10">
    <div class="panel panel-hero rounded-3xl p-8 md:p-12">
      <p class="kicker">Privacidad</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold md:text-4xl">
        Tus datos viven en tu teléfono
      </h2>
      <p class="mt-4 max-w-2xl text-muted">
        GymLab guarda tu historial en el dispositivo. Entrenas sin crear una cuenta y tus
        datos no se comparten con terceros.
      </p>
      <a
        href="/privacidad"
        class="mt-6 inline-block font-medium text-accent underline-offset-4 hover:underline"
      >
        Leer la política de privacidad →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-20 md:py-24">
    <p class="kicker">FAQ</p>
    <h2 class="mt-3 text-3xl font-semibold md:text-4xl">Preguntas frecuentes</h2>
    <div class="mt-10 flex flex-col gap-3">
      {
        faqs.map((item) => (
          <details class="panel group p-5">
            <summary class="cursor-pointer list-none font-medium">{item.q}</summary>
            <p class="mt-3 text-sm text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
