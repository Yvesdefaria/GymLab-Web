---
// The canonical landing, rendered once per locale by `getStaticPaths`.
// Sections resolve their own language from `Astro.url`, so no copy is passed down.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import Hero from '../../components/sections/Hero.astro';
import ProofBand from '../../components/sections/ProofBand.astro';
import FeatureBoard from '../../components/sections/FeatureBoard.astro';
import Showcase from '../../components/sections/Showcase.astro';
import Calculators from '../../components/sections/Calculators.astro';
import PrivacyBand from '../../components/sections/PrivacyBand.astro';
import Faq from '../../components/sections/Faq.astro';
import ClosingBand from '../../components/sections/ClosingBand.astro';
import { LOCALES, getLang } from '../../i18n';
import { organization, softwareApplication, webSite } from '../../lib/schema';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLang(Astro.url.pathname);
---
<BaseLayout>
  <StructuredData
    slot="head"
    nodes={[organization(lang), webSite(lang), softwareApplication(lang)]}
  />
  <Hero />
  <ProofBand />
  <FeatureBoard />
  <Showcase />
  <Calculators />
  <PrivacyBand />
  <Faq />
  <ClosingBand />
</BaseLayout>
