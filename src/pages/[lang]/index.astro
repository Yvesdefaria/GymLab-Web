---
// The canonical landing, rendered once per locale by `getStaticPaths`.
// Sections resolve their own language from `Astro.url`, so no copy is passed down.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import Hero from '../../components/sections/Hero.astro';
import ProofBand from '../../components/sections/ProofBand.astro';
import FeatureBoard from '../../components/sections/FeatureBoard.astro';
import Showcase from '../../components/sections/Showcase.astro';
import Calculators from '../../components/sections/Calculators.astro';
import PrivacyBand from '../../components/sections/PrivacyBand.astro';
import Faq from '../../components/sections/Faq.astro';
import ClosingBand from '../../components/sections/ClosingBand.astro';
import { LOCALES } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
---
<BaseLayout>
  <StructuredData slot="head" />
  <Hero />
  <ProofBand />
  <FeatureBoard />
  <Showcase />
  <Calculators />
  <PrivacyBand />
  <Faq />
  <ClosingBand />
</BaseLayout>
