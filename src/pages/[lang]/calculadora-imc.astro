---
// BMI calculator, rendered once per locale.
// The same numbers render on the server (so the page is useful without JS and the
// HTML carries the result) and are recomputed on input by the bundled script.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, getLang, localePath, useTranslations } from '../../i18n';
import { calcIMC, getIMCCategory, type IMCCategory } from '../../lib/calculators';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const c = t.calc.imc;

// Seed values, so the page answers something before the visitor types.
const SEED_WEIGHT = 80;
const SEED_HEIGHT = 180;

const fmt = (value: number): string => value.toLocaleString(lang, { maximumFractionDigits: 1 });
const seedIMC = calcIMC(SEED_WEIGHT, SEED_HEIGHT);
const categoryLabel = (category: IMCCategory): string => c.result.categories[category];
---

<BaseLayout title={c.meta.title} description={c.meta.description}>
  <section class="floor-section calc-page" aria-labelledby="calc-title">
    <div class="frame">
      <header class="section-frame">
        <div class="section-frame__rule">
          <span class="section-frame__label">{c.label}</span>
          <span class="section-frame__meta">{lang === 'en' ? 'BMI' : 'IMC'}</span>
        </div>
        <h1 id="calc-title">{c.title}</h1>
        <p class="calc-page__sub">{c.sub}</p>
      </header>

      <div class="calc-page__grid">
        <form class="calc-form" id="imc-form" novalidate>
          <fieldset>
            <legend>{c.form.legend}</legend>

            <label for="imc-weight">{c.form.weight}</label>
            <div class="calc-form__field">
              <input
                id="imc-weight"
                name="weight"
                type="number"
                inputmode="decimal"
                min="0"
                step="0.5"
                value={SEED_WEIGHT}
                aria-describedby="imc-weight-hint"
              />
              <span class="calc-form__unit">{c.form.weightUnit}</span>
            </div>
            <p class="calc-form__hint" id="imc-weight-hint">{c.form.weightHint}</p>

            <label for="imc-height">{c.form.height}</label>
            <div class="calc-form__field">
              <input
                id="imc-height"
                name="height"
                type="number"
                inputmode="numeric"
                min="0"
                step="1"
                value={SEED_HEIGHT}
                aria-describedby="imc-height-hint"
              />
              <span class="calc-form__unit">{c.form.heightUnit}</span>
            </div>
            <p class="calc-form__hint" id="imc-height-hint">{c.form.heightHint}</p>
          </fieldset>
        </form>

        <aside class="calc-result" aria-labelledby="imc-result-title">
          <h2 id="imc-result-title">{c.result.legend}</h2>

          <dl class="calc-result__list" aria-live="polite">
            <div class="calc-result__row calc-result__row--lead">
              <dt>{c.result.value}</dt>
              <dd>
                <output id="imc-value">{fmt(seedIMC)}</output>
                {c.result.unit}
              </dd>
            </div>
            <div class="calc-result__row">
              <dt>{c.result.category}</dt>
              <dd>
                <output
                  id="imc-category"
                  data-underweight={c.result.categories.underweight}
                  data-normal={c.result.categories.normal}
                  data-overweight={c.result.categories.overweight}
                  data-obese={c.result.categories.obese}>{categoryLabel(getIMCCategory(seedIMC))}</output>
              </dd>
            </div>
          </dl>

          <p
            class="calc-result__note"
            id="imc-note"
            role="status"
            data-invalid={c.result.invalid}
            hidden
          ></p>
        </aside>
      </div>

      <div class="calc-page__prose">
        <section aria-labelledby="imc-explain">
          <h2 id="imc-explain">{c.explain.title}</h2>
          {c.explain.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section aria-labelledby="imc-limits">
          <h2 id="imc-limits">{c.limits.title}</h2>
          <ul>
            {c.limits.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      <div class="calc-page__actions">
        <a href="https://app.gymlab.dev" class="btn btn--primary">{c.cta}</a>
        <a href={localePath(lang)} class="btn btn--ghost">{c.back}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Reuses the site tokens; the visual work is deferred on purpose. */
  .section-frame h1 {
    margin: clamp(1.4rem, 2.5vw, 2rem) 0 0;
    max-width: 20ch;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.6vw, 4.4rem);
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .calc-page__sub {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .calc-page__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  .calc-form fieldset {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-elevated) 70%, transparent);
  }

  .calc-form legend {
    padding-inline: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .calc-form label {
    display: block;
    margin-top: 1.25rem;
    font-weight: 600;
  }

  .calc-form__field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .calc-form input {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
    color: var(--color-fg);
    font: inherit;
    font-size: 1.25rem;
  }

  .calc-form input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .calc-form__unit {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .calc-form__hint {
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .calc-result {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
  }

  .calc-result h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .calc-result__list {
    margin: 1.25rem 0 0;
  }

  .calc-result__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--color-border);
  }

  .calc-result__row dt {
    color: var(--color-muted);
  }

  .calc-result__row dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .calc-result__row--lead dd {
    font-size: 2.25rem;
    color: var(--color-accent-soft);
  }

  .calc-result__note {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .calc-page__prose {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  .calc-page__prose h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .calc-page__prose p {
    margin-top: 0.75rem;
    color: var(--color-muted);
    max-width: 62ch;
  }

  .calc-page__prose ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
    max-width: 62ch;
  }

  .calc-page__prose li + li {
    margin-top: 0.5rem;
  }

  .calc-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 900px) {
    .calc-page__grid {
      grid-template-columns: 1fr 1fr;
    }

    .calc-page__prose {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  import { calcIMC, getIMCCategory } from '../../lib/calculators';

  const weightInput = document.querySelector('#imc-weight');
  const heightInput = document.querySelector('#imc-height');
  const valueOut = document.querySelector('#imc-value');
  const categoryOut = document.querySelector('#imc-category');
  const note = document.querySelector('#imc-note');

  // The messages and the category labels live in the markup so this script owns no copy.
  const messages = {
    invalid: note?.getAttribute('data-invalid') ?? '',
  };

  const labels = {
    underweight: categoryOut?.getAttribute('data-underweight') ?? '',
    normal: categoryOut?.getAttribute('data-normal') ?? '',
    overweight: categoryOut?.getAttribute('data-overweight') ?? '',
    obese: categoryOut?.getAttribute('data-obese') ?? '',
  };

  const locale = document.documentElement.lang || 'es';
  const fmt = (value) => value.toLocaleString(locale, { maximumFractionDigits: 1 });

  const setNote = (text) => {
    if (!note) return;
    note.textContent = text;
    note.hidden = text === '';
  };

  const update = () => {
    if (!weightInput || !heightInput || !valueOut || !categoryOut) return;

    const weight = Number(weightInput.value);
    const height = Number(heightInput.value);

    if (!Number.isFinite(weight) || !Number.isFinite(height) || weight <= 0 || height <= 0) {
      valueOut.textContent = '—';
      categoryOut.textContent = '—';
      setNote(messages.invalid);
      return;
    }

    const imc = calcIMC(weight, height);
    valueOut.textContent = fmt(imc);
    categoryOut.textContent = labels[getIMCCategory(imc)];
    setNote('');
  };

  weightInput?.addEventListener('input', update);
  heightInput?.addEventListener('input', update);
</script>
