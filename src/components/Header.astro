---
// Global header: brand, the Explorar menu, search, language switch and app CTA.
// The bar navigates the site on every page; landing sections are reached by
// scrolling, never from here. The landing uses the transparent overlay variant
// over the hero atmosphere; legal and content pages keep the solid variant.
import { calcPath, getLang, localePath, localeSwitchPath, ROUTES, useTranslations } from '../i18n';
import { getGuideNav } from '../lib/guides-nav';
import Search from './Search.astro';

interface Props {
  /** Explicit alternate paths for pages whose slug changes per locale. */
  alternates?: { es: string; en: string };
}

const { alternates } = Astro.props;

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
const s = t.search;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isLanding = /^\/(?:es|en)$/.test(path);

const homePath = localePath(lang);

const languages = [
  { code: 'es', label: 'ES', name: t.header.language.es },
  { code: 'en', label: 'EN', name: t.header.language.en },
] as const;

const guideBlocks = await getGuideNav(lang);
const guidesPath = localePath(lang, ROUTES.guides[lang]);
const guidesTotal = guideBlocks.reduce((total, block) => total + block.total, 0);
const sectionsTotal = guideBlocks.reduce((total, block) => total + block.sections.length, 0);

const pages = [
  { title: t.calculators.items[0].title, href: localePath(lang, calcPath(lang, 'oneRm')) },
  { title: t.calculators.items[1].title, href: localePath(lang, calcPath(lang, 'bmi')) },
  { title: t.calculators.items[2].title, href: localePath(lang, calcPath(lang, 'calories')) },
  { title: t.footer.links.privacy, href: localePath(lang, ROUTES.privacy[lang]) },
  { title: t.footer.links.terms, href: localePath(lang, ROUTES.terms[lang]) },
  { title: t.header.contact, href: 'mailto:gymlab@gymlab.dev' },
];
---
<header
  class:list={[
    'site-header',
    isLanding ? 'site-header--overlay' : 'site-header--solid',
  ]}
>
  <div class="frame site-header__inner">
    <a href={homePath} class="site-header__brand" aria-label={t.header.brandLabel}>
      <img class="site-header__mark" src="/brand/logo_marca.svg" alt="" width="35" height="12" />
      <span class="site-header__wordmark">GymLab</span>
    </a>

    <button
      type="button"
      class="site-header__link site-bar__trigger"
      data-explore-trigger
      aria-expanded="false"
      aria-controls="explore-menu"
    >
      {s.explore}
      <span class="site-bar__chev" aria-hidden="true" />
    </button>

    <Search variant="bar" />

    <div class="site-header__tail">
      <div class="lang-switch" role="group" aria-label={t.header.language.label}>
        {
          languages.map((item) => (
            <a
              href={alternates?.[item.code] ?? localeSwitchPath(Astro.url.pathname, item.code)}
              class="lang-switch__link"
              aria-current={item.code === lang ? 'page' : undefined}
              hreflang={item.code}
              lang={item.code}
            >
              {item.code === 'es' ? (
                <svg class="lang-switch__flag" viewBox="0 0 60 40" aria-hidden="true" focusable="false">
                  <rect width="60" height="40" fill="#c60b1e" />
                  <rect y="10" width="60" height="20" fill="#ffc400" />
                </svg>
              ) : (
                <svg class="lang-switch__flag" viewBox="0 0 60 30" aria-hidden="true" focusable="false">
                  <clipPath id="lang-uk-counterchange">
                    <path d="M30 15h30v15zv15H30zh-30V15zv-15h30z" />
                  </clipPath>
                  <rect width="60" height="30" fill="#012169" />
                  <path d="M0 0l60 30m0-30L0 30" stroke="#ffffff" stroke-width="6" />
                  <path
                    d="M0 0l60 30m0-30L0 30"
                    clip-path="url(#lang-uk-counterchange)"
                    stroke="#c8102e"
                    stroke-width="4"
                  />
                  <path d="M30 0v30M0 15h60" stroke="#ffffff" stroke-width="10" />
                  <path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6" />
                </svg>
              )}
              <span class="lang-switch__code">{item.label}</span>
              <span class="lang-switch__name">{item.name}</span>
            </a>
          ))
        }
      </div>

      <a href="https://app.gymlab.dev" class="btn btn--ghost btn--sm site-header__cta">
        <span class="site-header__cta-long">{t.header.cta}</span>
        <span class="site-header__cta-short">{t.header.ctaShort}</span>
      </a>
    </div>
  </div>
</header>

<div class="explore" id="explore-menu" data-explore-menu hidden>
  <div class="explore__search">
    <Search variant="panel" />
  </div>

  <nav class="explore__cols" data-explore-cols aria-label={s.menuLabel}>
    <div class="explore__col">
      <p class="explore__label">{s.library}</p>
      {
        guideBlocks.map((block) => (
          <a class="explore__row" href={`${guidesPath}#${block.id}`}>
            <b>{block.label}</b>
            <span>{block.total}</span>
          </a>
        ))
      }
      <a class="explore__all" href={guidesPath}>{s.allGuides}</a>
    </div>

    <div class="explore__col">
      <p class="explore__label">{s.pages}</p>
      {
        pages.map((page) => (
          <a class="explore__row" href={page.href}>
            <b>{page.title}</b>
          </a>
        ))
      }
    </div>
  </nav>

  <div class="explore__foot" data-explore-foot>
    <span>{guidesTotal} {t.guidesHub.unitMany} · {sectionsTotal} {s.sections.toLowerCase()}</span>
    <span><kbd>Esc</kbd> {s.close}</span>
  </div>
</div>

<style>
  .site-header__tail {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
  }

  .site-header__cta {
    white-space: nowrap;
  }

  .site-header__cta-short {
    display: none;
  }

  /* ---------- Explorar trigger ---------- */
  .site-bar__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .site-bar__trigger[aria-expanded='true'] {
    color: var(--color-accent-soft);
  }

  .site-bar__chev {
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.3s var(--floor-ease);
  }

  .site-bar__trigger[aria-expanded='true'] .site-bar__chev {
    transform: translateY(1px) rotate(225deg);
  }

  /* ---------- Explorar panel ---------- */
  .explore {
    position: fixed;
    top: 5.25rem;
    left: max(var(--floor-gutter), calc((100vw - var(--floor-frame)) / 2));
    z-index: 40;
    width: min(680px, calc(100vw - var(--floor-gutter) * 2));
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: #17171a;
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.85);
  }

  /* The desktop bar owns the field; the panel only carries one on mobile. */
  .explore__search {
    display: none;
  }

  .explore__cols {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }

  .explore [hidden] {
    display: none;
  }

  .explore__col {
    padding: 1.125rem 1.25rem 1.4rem;
  }

  .explore__col + .explore__col {
    border-left: 1px solid var(--color-border);
  }

  .explore__label {
    margin: 0 0 0.4rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.54rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .explore__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.44rem 0;
    border-top: 1px solid transparent;
    color: var(--color-muted);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .explore__row b {
    color: var(--color-fg);
    font-weight: 400;
  }

  .explore__row span {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  .explore__row:hover b {
    color: var(--color-accent-soft);
  }

  .explore__all {
    display: inline-block;
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .explore__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.66rem;
  }

  .explore__foot kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    padding: 0 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
  }

  /* ---------- Language switch ---------- */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .lang-switch__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.3rem 0.35rem;
    border: 1px solid transparent;
    border-radius: 2px;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-decoration: none;
    transition:
      color 0.3s var(--floor-ease),
      border-color 0.3s var(--floor-ease),
      background-color 0.3s var(--floor-ease);
  }

  .lang-switch__link:hover {
    color: var(--color-accent-soft);
  }

  .lang-switch__link[aria-current='page'] {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent-soft);
  }

  .lang-switch__flag {
    display: block;
    height: 0.8rem;
    width: auto;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-fg) 14%, transparent);
  }

  .lang-switch__code {
    text-transform: uppercase;
  }

  /* The language is spelled out for screen readers, so the visible ES/EN stays
     the accessible name and never depends on reading a flag. */
  .lang-switch__name {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    border: 0;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  @media (max-width: 1023px) {
    .site-header__inner {
      gap: 1rem;
    }
  }

  /* Below 768px the bar drops the desktop search field and the panel becomes a
     full-width sheet with the search at the top and two stacked columns. The bar
     also tightens: the emblem, Explorar, locale and CTA replace the wordmark so
     every control keeps a readable size. */
  @media (max-width: 767px) {
    .site-header__inner {
      gap: 0.4rem;
    }

    .site-header__tail {
      gap: 0.3rem;
    }

    .site-header__wordmark {
      font-size: 1.05rem;
      letter-spacing: 0.05em;
    }

    /* Codes stay, flags go: the language is still spelled out for screen readers. */
    .lang-switch__flag {
      display: none;
    }

    .site-header__cta-long {
      display: none;
    }

    .site-header__cta-short {
      display: inline;
    }

    .site-bar__trigger {
      gap: 0.3rem;
      font-size: 0.55rem;
    }

    .lang-switch__link {
      min-width: 2.25rem;
      min-height: 2.75rem;
      padding: 0 0.15rem;
      gap: 0.2rem;
    }

    .site-header .btn--sm {
      font-size: 0.52rem;
      letter-spacing: 0.08em;
      padding: 0.4rem 0.5rem;
    }

    .explore {
      top: 4.75rem;
      left: 0;
      width: 100%;
      max-height: calc(100dvh - 4.75rem);
      border-right: 0;
      border-left: 0;
      border-radius: 0;
    }

    .explore__search {
      display: block;
      padding: 0.75rem;
      border-bottom: 1px solid var(--color-border);
    }

    .explore__cols {
      grid-template-columns: 1fr;
    }

    .explore__col + .explore__col {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }

  /* Below 330px the four controls need one more step to stay inside 320px. */
  @media (max-width: 329px) {
    .site-header__wordmark {
      display: none;
    }

    .site-bar__chev {
      display: none;
    }

    .lang-switch__flag {
      display: none;
    }

    .lang-switch__link {
      min-width: 2rem;
    }

    .site-header .btn--sm {
      padding: 0.35rem 0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switch__link,
    .site-bar__chev {
      transition: none;
    }
  }
</style>

<script>
  const trigger = document.querySelector<HTMLElement>('[data-explore-trigger]');
  const menu = document.querySelector<HTMLElement>('[data-explore-menu]');

  if (trigger && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));

      // Clearing the panel search restores the columns for the next opening.
      if (!open) {
        const input = menu.querySelector<HTMLInputElement>('[data-search-input]');
        if (input && input.value !== '') {
          input.value = '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    };

    trigger.addEventListener('click', () => setOpen(menu.hidden));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!menu.hidden && !menu.contains(target) && !trigger.contains(target)) {
        setOpen(false);
      }
    });
  }
</script>
