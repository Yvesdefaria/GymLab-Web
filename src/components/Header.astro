---
// Sticky marketing header: brand mark + section links.
// The landing uses the transparent overlay variant over the hero atmosphere;
// legal pages keep the solid, readable variant.
const links = [
  { href: '/#features', label: 'Funciones' },
  { href: '/#capturas', label: 'Capturas' },
  { href: '/#faq', label: 'FAQ' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isLanding = path === '/';
---
<header
  class:list={[
    'site-header',
    isLanding ? 'site-header--overlay' : 'site-header--solid',
  ]}
>
  <div class="frame site-header__inner">
    <a href="/" class="site-header__brand" aria-label="GymLab — inicio">
      <img src="/brand/logo_simbolo_gold.svg" alt="" width="26" height="26" />
      <span class="site-header__wordmark">GymLab</span>
    </a>

    <nav class="site-header__nav" aria-label="Secciones">
      {
        links.map((link) => (
          <a href={link.href} class="site-header__link">
            {link.label}
          </a>
        ))
      }
      <a href="mailto:gymlab@gymlab.dev" class="site-header__link">Contacto</a>
    </nav>

    <a
      href="mailto:gymlab@gymlab.dev?subject=GymLab%3A%20av%C3%ADsame%20cuando%20salga"
      class="btn btn--ghost btn--sm site-header__cta"
    >
      Avísame cuando salga
    </a>
  </div>
</header>
