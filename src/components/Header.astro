---
// Sticky marketing header: brand mark + section links.
const links = [
  { href: '/#features', label: 'Funciones' },
  { href: '/#capturas', label: 'Capturas' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="sticky top-0 z-50 border-b border-border/50 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-6 px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="GymLab — inicio">
      <img src="/brand/logo_simbolo_gold.svg" alt="" width="28" height="28" />
      <span class="font-display text-xl font-semibold tracking-wide">GymLab</span>
    </a>
    <nav class="flex items-center gap-6" aria-label="Secciones">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hidden text-sm font-medium text-muted transition-colors hover:text-accent sm:block"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="mailto:gymlab@gymlab.dev"
        class="text-sm font-medium text-muted transition-colors hover:text-accent"
      >
        Contacto
      </a>
    </nav>
  </div>
</header>
