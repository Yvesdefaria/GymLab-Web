---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="frame">
    <div class="site-footer__grid">
      <div>
        <a href="/" class="site-footer__brand" aria-label="GymLab — inicio">
          <img src="/brand/logo_simbolo_gold.svg" alt="" width="24" height="24" />
          <span class="site-footer__wordmark">GymLab</span>
        </a>
        <p class="site-footer__tagline">Entrena con un plan. Mira tu progreso.</p>
      </div>

      <nav class="site-footer__nav" aria-label="Legal y contacto">
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos</a>
        <a href="mailto:gymlab@gymlab.dev">Contacto</a>
      </nav>
    </div>

    <div class="site-footer__meta">
      <span>© {year} GymLab</span>
      <span>Piso 1 · GymLab.dev</span>
    </div>
  </div>
</footer>
