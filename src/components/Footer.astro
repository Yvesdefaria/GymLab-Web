---
import { getLang, localePath, useTranslations } from '../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

const year = new Date().getFullYear();

const homePath = localePath(lang);
---
<footer class="site-footer">
  <div class="frame">
    <div class="site-footer__grid">
      <div>
        <a href={homePath} class="site-footer__brand" aria-label={t.footer.brandLabel}>
          <img src="/brand/logo_simbolo_gold.svg" alt="" width="24" height="24" />
          <span class="site-footer__wordmark">GymLab</span>
        </a>
        <p class="site-footer__tagline">{t.footer.tagline}</p>
      </div>

      <nav class="site-footer__nav" aria-label={t.footer.navLabel}>
        <a href={localePath(lang, '/privacidad')}>{t.footer.links.privacy}</a>
        <a href={localePath(lang, '/terminos')}>{t.footer.links.terms}</a>
        <a href="mailto:gymlab@gymlab.dev">{t.footer.links.contact}</a>
      </nav>
    </div>

    <div class="site-footer__meta">
      <span>© {year} GymLab</span>
      <span>{t.footer.meta}</span>
    </div>
  </div>
</footer>
