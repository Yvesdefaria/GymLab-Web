<section id="privacidad" class="privacy-band" aria-labelledby="privacy-title">
  <div class="frame">
    <div class="section-frame__rule">
      <span class="section-frame__label">Privacidad</span>
    </div>

    <div class="privacy-grid">
      <div>
        <h2 id="privacy-title">Tus datos viven en tu teléfono</h2>
        <p>
          GymLab guarda tu historial en el dispositivo. Entrenas sin crear una cuenta y tus
          datos no se comparten con terceros.
        </p>
        <a href="/privacidad" class="text-link">Leer la política de privacidad →</a>
      </div>

      <div class="local-diagram" aria-hidden="true">
        <div class="local-diagram__ring"></div>
        <div class="local-diagram__phone"></div>
        <div class="local-diagram__dot"></div>
        <span class="local-diagram__tag local-diagram__tag--top">Sin cuenta</span>
        <span class="local-diagram__tag local-diagram__tag--bottom">En el dispositivo</span>
      </div>
    </div>
  </div>
</section>
