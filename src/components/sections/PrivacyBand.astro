---
import { getLang, localePath, useTranslations } from '../../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
---

<section id={t.privacy.anchor} class="privacy-band" aria-labelledby="privacy-title">
  <div class="frame">
    <div class="section-frame__rule">
      <span class="section-frame__label">{t.privacy.label}</span>
    </div>

    <div class="privacy-grid">
      <div>
        <h2 id="privacy-title">{t.privacy.title}</h2>
        <p>
          {t.privacy.text}
        </p>
        <a href={localePath(lang, '/privacidad')} class="text-link">{t.privacy.link}</a>
      </div>

      <div class="local-diagram" aria-hidden="true">
        <div class="local-diagram__ring"></div>
        <div class="local-diagram__phone"></div>
        <div class="local-diagram__dot"></div>
        <span class="local-diagram__tag local-diagram__tag--top">{t.privacy.tags.top}</span>
        <span class="local-diagram__tag local-diagram__tag--bottom">{t.privacy.tags.bottom}</span>
      </div>
    </div>
  </div>
</section>
