---
import { getLang, useTranslations } from '../../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

const week = [
  { h: '30%', on: false },
  { h: '54%', on: true },
  { h: '20%', on: false },
  { h: '66%', on: true },
  { h: '42%', on: false },
  { h: '76%', on: true },
  { h: '34%', on: false },
];

const volume = ['42%', '58%', '38%', '66%', '51%', '72%', '60%', '88%'];
const steps = ['32%', '54%', '46%', '62%', '40%', '74%', '58%'];
const catalogLetters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I'];
const streakDays = Array.from({ length: 28 }, (_, index) => index);
const activeDays = new Set([2, 3, 4, 5, 8, 9, 10, 11, 12, 16, 17, 18, 22, 23, 24, 25, 26]);
---

<section id={t.features.anchor} class="floor-section" aria-labelledby="features-title">
  <div class="frame">
    <header class="section-frame">
      <div class="section-frame__rule">
        <span class="section-frame__label">{t.features.label}</span>
        <span class="section-frame__meta">01—08</span>
      </div>
      <h2 id="features-title">{t.features.title}</h2>
    </header>

    <div class="station-board">
      {
        t.features.items.map((feature) => (
          <article class:list={['station', `station--${Number(feature.n)}`]}>
            <div class="station__head">
              <span class="station__no">{feature.n}</span>
              <h3>{feature.title}</h3>
            </div>

            <p class="station__text">{feature.text}</p>

            <div class="station__visual" aria-hidden="true">
              {feature.n === '01' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.week.label}</span>
                    <span>{t.features.mini.week.meta}</span>
                  </div>
                  <div class="mini-week">
                    <div class="mini-week__days">
                      {t.features.mini.week.days.map((day) => (
                        <span>{day}</span>
                      ))}
                    </div>
                    <div class="mini-week__bars">
                      {week.map((day) => (
                        <span class:list={[day.on && 'is-on']} style={`--h:${day.h}`}></span>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {feature.n === '02' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.sets.label}</span>
                    <span>{t.features.mini.sets.meta}</span>
                  </div>
                  <table class="mini-sets">
                    <thead>
                      <tr>
                        {t.features.mini.sets.columns.map((column) => (
                          <th scope="col">{column}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>01</td>
                        <td>80</td>
                        <td>8</td>
                      </tr>
                      <tr class="is-current">
                        <td>02</td>
                        <td>{t.features.mini.sets.currentLoad}</td>
                        <td>8</td>
                      </tr>
                      <tr>
                        <td>03</td>
                        <td>85</td>
                        <td>6</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              )}

              {feature.n === '03' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.volume.label}</span>
                    <span>{t.features.mini.volume.meta}</span>
                  </div>
                  <div class="mini-bars">
                    {volume.map((height, barIndex) => (
                      <span class:list={[barIndex === 5 && 'is-on']} style={`--h:${height}`} />
                    ))}
                  </div>
                </div>
              )}

              {feature.n === '04' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.calculators.label}</span>
                    <span>{t.features.mini.calculators.meta}</span>
                  </div>
                  <ul class="calc-chips">
                    {t.features.mini.calculators.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              {feature.n === '05' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.catalogue.label}</span>
                    <span>{t.features.mini.catalogue.meta}</span>
                  </div>
                  <div class="mini-catalog">
                    <div class="mini-catalog__filters">
                      {t.features.mini.catalogue.filters.map((filter) => (
                        <span>{filter}</span>
                      ))}
                    </div>
                    <div class="mini-catalog__grid">
                      {catalogLetters.map((letter) => (
                        <span>
                          <b>{letter}</b>
                          <i></i>
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {feature.n === '06' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.compare.label}</span>
                    <span>{t.features.mini.compare.meta}</span>
                  </div>
                  <div class="mini-compare">
                    <div class="mini-compare__frame mini-compare__frame--a">
                      <span>A</span>
                    </div>
                    <div class="mini-compare__frame mini-compare__frame--b">
                      <span>B</span>
                    </div>
                    <div class="mini-compare__seam"></div>
                  </div>
                </div>
              )}

              {feature.n === '07' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.steps.label}</span>
                    <span>{t.features.mini.steps.meta}</span>
                  </div>
                  <div class="mini-steps">
                    <div class="mini-steps__bars">
                      {steps.map((height, barIndex) => (
                        <span class:list={[barIndex === 5 && 'is-on']} style={`--h:${height}`}></span>
                      ))}
                    </div>
                    <div class="mini-steps__device"></div>
                  </div>
                </div>
              )}

              {feature.n === '08' && (
                <div class="mini">
                  <div class="mini__meta">
                    <span>{t.features.mini.streak.label}</span>
                    <span>{t.features.mini.streak.meta}</span>
                  </div>
                  <div class="mini-streak">
                    {streakDays.map((day) => (
                      <span
                        class:list={[
                          activeDays.has(day) && 'is-on',
                          day === 26 && 'is-ring',
                        ]}
                      ></span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
