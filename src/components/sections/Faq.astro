---
import { getLang, useTranslations } from '../../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
---

<section id={t.faq.anchor} class="floor-section" aria-labelledby="faq-title">
  <div class="frame">
    <div class="section-frame__rule">
      <span class="section-frame__label">{t.faq.label}</span>
    </div>

    <div class="faq-layout">
      <h2 id="faq-title">{t.faq.title}</h2>

      <div class="faq-list">
        {
          t.faq.items.map((item) => (
            <details class="faq-item">
              <summary>
                <span>{item.q}</span>
                <span class="faq-mark" aria-hidden="true"></span>
              </summary>
              <p class="faq-item__answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
