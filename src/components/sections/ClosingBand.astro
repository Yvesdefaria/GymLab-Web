---
import { getLang, useTranslations } from '../../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
---

<section id={t.closing.anchor} class="closing-band" aria-labelledby="closing-title">
  <div class="frame">
    <h2 id="closing-title">{t.closing.title}</h2>

    <div class="closing-band__row">
      <p>{t.closing.text}</p>

      <div class="closing-band__actions">
        <a
          href={`mailto:gymlab@gymlab.dev?subject=${encodeURIComponent(t.closing.mailtoSubject)}`}
          class="btn btn--ink"
        >
          {t.closing.cta}
        </a>
        <span class="closing-band__stamp">{t.closing.stamp}</span>
      </div>
    </div>

    <div class="closing-band__mark" aria-hidden="true">{t.closing.mark}</div>
  </div>
</section>
