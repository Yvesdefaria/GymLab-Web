---
import { getLang, useTranslations } from '../../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);

const shots = [
  // Decisión (2026-10-22): las tres capturas son solo en inglés y las comparten
  // los dos idiomas. La app arranca en inglés por defecto, así que muestran lo que
  // ve un usuario nuevo; se evaluó hacer un set por idioma y el dueño lo descartó.
  {
    src375: '/screens/home-en-375.webp',
    src750: '/screens/home-en-750.webp',
    className: '',
  },
  {
    src375: '/screens/entrenamiento-en-375.webp',
    src750: '/screens/entrenamiento-en-750.webp',
    className: 'evidence--session',
  },
  {
    src375: '/screens/estadisticas-en-375.webp',
    src750: '/screens/estadisticas-en-750.webp',
    className: '',
  },
];
---

<section id={t.showcase.anchor} class="floor-section showcase" aria-labelledby="showcase-title">
  <div class="frame">
    <header class="section-frame">
      <div class="section-frame__rule">
        <span class="section-frame__label">{t.showcase.label}</span>
        <span class="section-frame__meta">01—03</span>
      </div>
      <h2 id="showcase-title">{t.showcase.title}</h2>
    </header>

    <div class="evidence-stage">
      {
        shots.map((shot, index) => (
          <figure class:list={['evidence', shot.className]}>
            <div class="evidence__frame">
              <img
                src={shot.src750}
                srcset={`${shot.src375} 375w, ${shot.src750} 750w`}
                sizes="(min-width: 768px) 360px, 90vw"
                alt={t.showcase.shots[index].alt}
                width="375"
                height="812"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span>{`0${index + 1}`}</span>
              {t.showcase.shots[index].caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
