---
import { getLang, useTranslations } from '../../i18n';

const lang = getLang(Astro.url.pathname);
const t = useTranslations(lang);
---

<section class="proof-band" aria-label={t.proof.label}>
  <div class="frame">
    <dl class="proof-band__inner">
      {
        t.proof.stats.map((stat) => (
          <div class:list={['proof-stat', stat.word && 'proof-stat--word']}>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
