---
const stats = [
  { label: 'Ejercicios con foto', value: '873' },
  { label: 'Calculadoras', value: '9' },
  { label: 'Plantillas', value: '68' },
  { label: 'Funciona sin conexión', value: 'Offline', word: true },
];
---

<section class="proof-band" aria-label="Datos de GymLab">
  <div class="frame">
    <dl class="proof-band__inner">
      {
        stats.map((stat) => (
          <div class:list={['proof-stat', stat.word && 'proof-stat--word']}>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
