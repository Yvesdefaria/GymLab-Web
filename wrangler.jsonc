{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymlab-web",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    // Without this, Workers Static Assets answers unmatched paths with a bare
    // 404 and a zero-byte body. `404-page` serves dist/404.html instead.
    "not_found_handling": "404-page"
  }
}
